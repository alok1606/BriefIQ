BRIEFIQ_MODE=demo
TAVILY_API_KEY=
# Gateway origin, with or without /v1. Provider credentials belong in Bifrost.
BIFROST_BASE_URL=http://localhost:8080
BIFROST_MODEL=gemini/gemini-2.5-flash-lite
# Optional free-tier Google API key, loaded ONLY by scripts/start_free_gateway.py.
# Provider calls still pass through Bifrost; BriefIQ never calls Google directly.
GEMINI_API_KEY=
BIFROST_VIRTUAL_KEY=
# Optional HTTP Bearer authentication, separate from the virtual key.
BIFROST_API_KEY=
REQUEST_TIMEOUT=45
